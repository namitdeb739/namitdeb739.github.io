    <!--
      2–4 sentences. Your dissertation is the obvious anchor: what problem,
      why it matters, what you're actually building.
    -->
    <span class="todo">TODO</span>: a short paragraph about you and your work.
  </p>

  <h2>projects</h2>
  {
    projects.length === 0 ? (
      <p><span class="todo">TODO</span>: add a Markdown file to src/content/projects/</p>
    ) : (
      projects.map((p) => (
        <a class="card" href={p.data.repo ?? p.data.link ?? `/projects/${p.id}`}>
          <h3>{p.data.title}</h3>
          <p>{p.data.summary}</p>
          {p.data.tech.length > 0 && (
            <div class="tech">{p.data.tech.map((t) => <span>{t}</span>)}</div>
          )}
