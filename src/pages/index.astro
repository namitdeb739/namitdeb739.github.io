---
// Homepage. Every visible string below is a placeholder — the prose is
// deliberately not written for you. Search for "TODO" to find them all.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Base title="TODO: page title" description="TODO: meta description, ~150 chars">
