---
// Homepage. Names, links and project metadata are real; anything left as a
// TODO placeholder is something only you can write. Search for "TODO".
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Base
  title="Namit Deb"
  description="TODO: meta description, ~150 chars — shown in search results and link previews"
>
  <h1>Namit Deb</h1>

  <p class="tagline">
    <!--
      One sentence. What you do and what makes it specific.
      Avoid "passionate", "aspiring", "tech enthusiast".
    -->
    <span class="todo">TODO</span>: one-sentence intro
  </p>

  <h2>about</h2>
  <p>
    <!--
      2–4 sentences. Your dissertation is the obvious anchor: what problem,
      why it matters, what you're actually building. The earth-computers repo
      is private, so decide how much to say.
    -->
    <span class="todo">TODO</span>: a short paragraph about you and your work.
  </p>

  <h2>projects</h2>
  {
    projects.map((p) => (
      <a class="card" href={p.data.repo ?? p.data.link ?? `/projects/${p.id}`}>
        <h3>{p.data.title}</h3>
        <p>{p.data.summary}</p>
        {p.data.tech.length > 0 && (
          <div class="tech">{p.data.tech.map((t) => <span>{t}</span>)}</div>
        )}
      </a>
    ))
  }

  <h2>elsewhere</h2>
  <ul>
    <li><a href="https://github.com/namitdeb739">github.com/namitdeb739</a></li>
    <li><a href="mailto:namitdeb739@gmail.com">namitdeb739@gmail.com</a></li>
    <li><span class="todo">TODO</span>: LinkedIn</li>
  </ul>
</Base>
