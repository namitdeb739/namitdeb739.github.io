---
// The shelf: every project as a numbered spine, in its own colour.
//
// Names, links and project metadata are real. Prose is carried across from the
// profile README — your words, not written here.
import Base from '../layouts/Base.astro';
import BassMark from '../components/BassMark.astro';
import { getShelf, identityOf, bengaliNum } from '../lib/projects';

const films = await getShelf();
const years = films.map((f) => f.data.year).filter((y): y is number => !!y);
const span = years.length ? `${Math.min(...years)}–${Math.max(...years)}` : '';
---

<Base
  title="Namit Deb"
  description="Computer scientist interested in sustainable applications of technology. Undergraduate thesis on low-power computers powered by soil microbial fuel-cells."
  rail={`Namit Deb · Selected work${span ? ` · ${span}` : ''}`}
>
  <section class="titlecard">
    <h1>Namit Deb</h1>
    <p class="sub">
      Computer scientist interested in sustainable applications of technology.
    </p>
    <div class="billing">
      <span><b>Embedded</b>bare-metal C · MSP430 · ESP32</span>
      <span><b>Python</b>uv · ruff · mypy · pytest</span>
      <span><b>Now</b>Undergraduate thesis</span>
    </div>
  </section>

  <p class="label">Currently</p>
  <p class="lede">
    Working on my undergraduate thesis, developing low-power computers with
    wireless communications capabilities powered by soil microbial fuel-cells.
    This could have major applications in the future of the agriculture
    industry!
  </p>

  <p class="label">Selected work</p>
  <div class="shelf">
    {films.map((p, i) => {
      const id = identityOf(p.id);
      return (
        <a class="spine" href={`/projects/${p.id}`} style={`--h: var(--h-${id.hue})`}>
          <span class="no" lang="bn">{bengaliNum(i + 1)}</span>
          <BassMark kind={id.kind} />
          <span>
            <h2 transition:name={`title-${p.id}`}>{p.data.title}</h2>
            <p class="meta">{p.data.summary}</p>
          </span>
          <span class="right">
            <b>{p.data.status ?? p.data.year ?? ''}</b>
            {[p.data.year, ...p.data.tech.slice(0, 2)].filter(Boolean).join(' · ')}
          </span>
          <span class="go" aria-hidden="true">→</span>
        </a>
      );
    })}
  </div>
</Base>
