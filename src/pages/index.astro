---
// Homepage. Names, links and project metadata are real; anything left as a
// Prose is carried across from the profile README — your words, not written here.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// Cards open each project's own page; the repo link lives there as "source →".
const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Base
  title="Namit Deb"
  description="Computer scientist interested in sustainable applications of technology. Undergraduate thesis on low-power computers powered by soil microbial fuel-cells."
>
  <h1>Namit Deb</h1>

  <p class="tagline">
    Computer scientist interested in sustainable applications of technology.
  </p>

  <h2>currently</h2>
  <p>
    Working on my undergraduate thesis, developing low-power computers with
    wireless communications capabilities powered by soil microbial fuel-cells.
    This could have major applications in the future of the agriculture
    industry!
  </p>

  <h2>projects</h2>
  {
    projects.map((p) => (
      <a class="card" href={`/projects/${p.id}`}>
        <h3>{p.data.title}</h3>
        <p>{p.data.summary}</p>
        {p.data.tech.length > 0 && (
          <div class="tech">{p.data.tech.map((t) => <span>{t}</span>)}</div>
        )}
      </a>
    ))
  }

  <h2>elsewhere</h2>
  <ul>
    <li><a href="https://github.com/namitdeb739">github.com/namitdeb739</a></li>
    <li><a href="mailto:namitdeb739@gmail.com">namitdeb739@gmail.com</a></li>
    <li><a href="https://www.linkedin.com/in/namitdeb739">linkedin.com/in/namitdeb739</a></li>
  </ul>
</Base>
